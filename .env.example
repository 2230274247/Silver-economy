# Copy to .env locally. Never commit actual credentials.
LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MAX_OUTPUT_TOKENS=256
DEEPSEEK_TASK_MAX_OUTPUT_TOKENS=512
DEEPSEEK_DAILY_REQUEST_LIMIT=10
DEEPSEEK_DAILY_TOKEN_LIMIT=20000
# All users/processes share the HK-day budget; unknown outcomes retain reservations.
MYSQL_DATABASE=silver_memory_demo_v01
MYSQL_USER=silver_demo
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=13306
DATABASE_URL=
TEST_DATABASE_URL=
SESSION_TTL_SECONDS=43200
COOKIE_SECURE=false
# scripts/init-dev-db.py generates both URLs and random local credentials.
