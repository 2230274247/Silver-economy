# Copy to .env locally. Never commit actual credentials.
LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MAX_OUTPUT_TOKENS=256
DEEPSEEK_TASK_MAX_OUTPUT_TOKENS=512
DEEPSEEK_DAILY_REQUEST_LIMIT=10
DEEPSEEK_DAILY_TOKEN_LIMIT=20000
MAPS_PROVIDER=disabled
AMAP_WEB_SERVICE_KEY=
AMAP_DAILY_REQUEST_LIMIT=20
# Device push IDs are encrypted at rest. Generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NOTIFICATIONS_PROVIDER=mock
NOTIFICATION_DEVICE_ENCRYPTION_KEY=
UNI_PUSH_BRIDGE_URL=
UNI_PUSH_BRIDGE_TOKEN=
# All users/processes share the HK-day budget; unknown outcomes retain reservations.
MYSQL_DATABASE=silver_memory_demo_v01
MYSQL_USER=silver_demo
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=13306
DATABASE_URL=
TEST_DATABASE_URL=
SESSION_TTL_SECONDS=43200
COOKIE_SECURE=false
# scripts/init-dev-db.py generates both URLs and random local credentials.
